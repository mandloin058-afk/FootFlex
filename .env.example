# Copy this file to ".env" and fill in your MySQL details.
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# mysql (default) or sqlite (only for quick testing without MySQL)
DB_ENGINE=mysql
DB_NAME=footflex
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
